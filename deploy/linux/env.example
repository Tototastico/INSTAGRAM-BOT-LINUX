# =====================================================================
# Configuración de Entorno para INSTAGRAM-BOT en Ubuntu VPS
# Copiar este archivo a /etc/instagram-bot/instagram-bot.env
# Permisos recomendados: chmod 600 /etc/instagram-bot/instagram-bot.env
# =====================================================================

# Directorio persistente de perfiles Chrome independientes para Linux
INSTAGRAM_ACCOUNTS_DIR=/var/lib/instagram-bot/accounts

# Ruta absoluta del archivo SQLite persistente (nunca en releases efímeros)
INSTAGRAM_BOT_DB_PATH=/var/lib/instagram-bot/data/bot.sqlite3

# Binario oficial de Google Chrome instalado en Ubuntu
INSTAGRAM_BOT_CHROME_BINARY=/usr/bin/google-chrome-stable

# Pantalla virtual Xvfb
DISPLAY=:99

# Directorio HOME del usuario de servicio
HOME=/var/lib/instagram-bot

# Entorno de ejecución
PYTHONUNBUFFERED=1
